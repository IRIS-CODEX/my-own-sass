# ==========================================
# LOCAL PC ENVIRONMENT CONFIGURATION (.env)
# ==========================================
# To run this project locally on your PC:
# 1. Copy this file and rename it to ".env"
# 2. Add your Gemini API Key from https://aistudio.google.com/app/apikey
# 3. Run "npm install" and "npm run dev"

# Google Gemini API Key (Required for live Gemini AI models & Multimodal capabilities)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Optional Google Maps Platform API Key (For Google Maps places & routing)
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY_HERE"

# Local Server & Port Configuration
PORT=3000
APP_URL="http://localhost:3000"

# Firebase Public Configuration (Auto-loaded from firebase-applet-config.json)
# Included in repo for seamless Firestore and Auth synchronization
VITE_FIREBASE_API_KEY="AIzaSyCfGTe6GcFSY-PNevN0_2BH7_k0J41qHUo"
VITE_FIREBASE_PROJECT_ID="tranquil-tomorrow-hrtgb"
VITE_FIREBASE_AUTH_DOMAIN="tranquil-tomorrow-hrtgb.firebaseapp.com"
